---
import Layout from '../../layouts/Layout.astro';
import Lola from '../../components/Lola.astro';
import { cursos, asignaturas, actividadesDe, type Curso, type Asignatura } from '../../data/cole';

export function getStaticPaths() {
  return cursos.flatMap((curso) =>
    asignaturas.map((asignatura) => ({
      params: { curso: curso.slug, asignatura: asignatura.slug },
      props: { curso, asignatura },
    })),
  );
}

const { curso, asignatura } = Astro.props as { curso: Curso; asignatura: Asignatura };
const lista = actividadesDe(curso.slug, asignatura.slug);
const tonos = ['#ff5d73', '#3a86ff', '#2ec4b6', '#9b5de5', '#ff9f1c', '#06d6a0', '#ef476f', '#118ab2'];
---

<Layout title={`${asignatura.nombre} · ${curso.nombre}`}>
  <h1 class="title" style={`color:${asignatura.color}`}><span>{asignatura.emoji}</span> {asignatura.nombre}</h1>
  <Lola texto={lista.length ? '¡Elige un juego!' : '¡Estoy preparando juegos nuevos!'} />

  {lista.length ? (
    <nav class="menu">
      {lista.map((act, i) => (
        <a class="card" href={act.url} style={`background:${tonos[i % tonos.length]}`}>
          <span class="em">{act.emoji}</span>
          {act.titulo}
          <small>{act.descripcion}</small>
        </a>
      ))}
    </nav>
  ) : (
    <div class="stage">
      <div class="em">🚧</div>
      <p>Aquí pronto habrá juegos de <b>{asignatura.nombre}</b>.</p>
    </div>
  )}

  <a class="back" href={`/${curso.slug}/`}>← Volver</a>
</Layout>
