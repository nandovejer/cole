---
import Layout from '../layouts/Layout.astro';
import Lola from '../components/Lola.astro';
import { asignaturas, leccionesDe, type Curso } from '../data/cole';
import { ui } from '../i18n/ui.js';
import { href, type Lang } from '../i18n/paths';

interface Props { lang: Lang; curso: Curso }
const { lang, curso } = Astro.props;
const t = ui[lang];
const backHref = href(lang, '/');
---

<Layout title={`${curso.nombre[lang]} · Cole`} lang={lang} back={backHref}>
  <h1 class="title"><span>{curso.emoji}</span> {curso.nombre[lang]}</h1>
  <Lola texto={t.lola.course} lang={lang} />
  <nav class="list">
    {asignaturas.map((a) => (
      <a class="tile" href={href(lang, `/${curso.slug}/${a.slug}/`)} style={`background:${a.color};--c:${a.color}`}>
        <span class="em">{a.emoji}</span>
        <span class="txt">{a.nombre[lang]}<small>{t.lessons(leccionesDe(curso.slug, a.slug).length)}</small></span>
        <span class="go" aria-hidden="true">▶</span>
      </a>
    ))}
  </nav>
  <a class="back" href={backHref}>← {t.back}</a>
</Layout>
