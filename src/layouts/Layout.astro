---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎒</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Andika:wght@400;700&family=Fredoka:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="cloud" style="width:140px;height:44px;top:9%;animation-duration:70s"></div>
    <div class="cloud" style="width:100px;height:32px;top:24%;animation-duration:95s;animation-delay:-40s"></div>
    <div class="cloud" style="width:170px;height:50px;top:4%;animation-duration:120s;animation-delay:-80s"></div>
    <div class="grass"></div>

    <main class="app">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root{
    --ink:#2b2d42; --sky1:#bde0fe; --sky2:#fff1d6;
    color-scheme:light;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;min-height:100%}
  body{font-family:'Andika',system-ui,sans-serif;color:var(--ink);
    background:linear-gradient(180deg,var(--sky1) 0%,#e7f5ff 55%,var(--sky2) 100%);
    background-attachment:fixed;min-height:100vh;overflow-x:hidden}

  .cloud{position:fixed;background:#fff;border-radius:60px;opacity:.85;z-index:0;animation:drift linear infinite}
  .cloud::before,.cloud::after{content:"";position:absolute;background:#fff;border-radius:50%}
  .cloud::before{width:55%;height:150%;left:15%;top:-60%}
  .cloud::after{width:40%;height:120%;right:12%;top:-40%}
  @keyframes drift{from{transform:translateX(-30vw)}to{transform:translateX(130vw)}}
  .grass{position:fixed;bottom:0;left:0;right:0;height:60px;z-index:0;
    background:radial-gradient(circle at 20px -10px,transparent 28px,#7ed957 29px) 0 0/40px 60px repeat-x}

  .app{position:relative;z-index:1;max-width:940px;margin:0 auto;padding:14px 16px 90px;animation:pop .35s ease}
  @keyframes pop{from{transform:scale(.94);opacity:0}}

  .title{font-family:'Fredoka',sans-serif;font-size:clamp(30px,6vw,48px);margin:0}
  .title span{display:inline-block;animation:bob 2.4s ease-in-out infinite}
  .title span:nth-child(2n){animation-delay:.3s}
  @keyframes bob{50%{transform:translateY(-5px)}}

  .menu{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:16px}
  .card{border:none;border-radius:28px;padding:22px 14px;cursor:pointer;font-family:'Fredoka',sans-serif;
    font-size:clamp(20px,3.6vw,28px);color:#fff;display:flex;flex-direction:column;align-items:center;gap:6px;
    text-align:center;text-decoration:none;transition:transform .15s;box-shadow:0 8px 0 rgba(0,0,0,.18)}
  .card:hover{transform:translateY(-3px)}
  .card:active{transform:translateY(6px);box-shadow:0 2px 0 rgba(0,0,0,.18)}
  .card .em{font-size:clamp(46px,9vw,70px);line-height:1.1}
  .card small{font-family:'Andika',sans-serif;font-size:15px}
  @media (max-width:420px){.menu{gap:12px}.card{padding:18px 8px}}

  .back{display:inline-block;font-family:'Fredoka',sans-serif;font-weight:700;color:var(--ink);text-decoration:none;
    border:3px solid #cbd5e1;background:#fff;border-radius:30px;padding:10px 18px;font-size:20px;
    box-shadow:0 4px 0 #cbd5e1;margin-top:20px}
  .back:active{transform:translateY(3px);box-shadow:0 1px 0 #cbd5e1}

  .stage{background:#fff;border-radius:30px;padding:24px 20px;text-align:center;margin-top:16px;box-shadow:0 6px 0 #d6e4f0}
  .stage .em{font-size:clamp(70px,15vw,110px);line-height:1.1}
  .stage p{font-size:clamp(20px,4vw,26px);margin:8px 0 0}
</style>
